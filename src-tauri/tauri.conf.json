{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TopBar Translate",
  "version": "1.0.0",
  "identifier": "com.hq970123.topbartranslate",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "url": "index.html",
        "title": "TopBar Translate",
        "width": 708,
        "height": 380,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "visible": false,
        "focus": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "dmg", "app"],
    "publisher": "hq970123",
    "category": "Productivity",
    "shortDescription": "鼠标触顶即可翻译",
    "longDescription": "TopBar Translate 是一款常驻屏幕顶部的轻量翻译工具：鼠标移到屏幕顶部即可展开翻译框，自动识别语言，默认使用免费的 Index-Translate，也可接入 OpenAI、DeepSeek、Gemini、Claude、DeepL、Microsoft Translator、Ollama 等服务。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "languages": ["SimpChinese", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      },
      "wix": {
        "language": "zh-CN"
      }
    }
  }
}
